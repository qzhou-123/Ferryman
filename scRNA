##比较 Naive CD4 T 和 Memory CD4 T,寻找两组细胞类型之间的差异基因
markers_cd4 <- FindMarkers(
  pbmc,
  ident.1 = "Naive CD4 T",
  ident.2 = "Memory CD4 T",
  only.pos = FALSE,
  min.pct = 0.25,
  logfc.threshold = 0.25
)

head(markers_cd4)

markers_cd4$gene <- rownames(markers_cd4)

ggplot(markers_cd4, aes(x = avg_log2FC, y = -log10(p_val_adj))) +
  geom_point(alpha = 0.5) +
  theme_minimal() +
  labs(title = "Naive CD4 T vs Memory CD4 T", x = "log2FC", y = "-log10(adj p)")


# Naive CD4 T 高表达的 top 10
top_up <- markers_cd4 %>% arrange(desc(avg_log2FC)) %>% head(10)
top_up

# Memory CD4 T 高表达的 top 10
top_down <- markers_cd4 %>% arrange(avg_log2FC) %>% head(10)
top_down

# 取 top 20 差异基因
top20 <- markers_cd4 %>% arrange(desc(abs(avg_log2FC))) %>% head(20)

# 关键改动：新建对象做 ScaleData，不要动 pbmc

