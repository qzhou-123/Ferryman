# 对差异基因做标准化
pbmc_cd4_sub <- ScaleData(pbmc_cd4_sub, features = top20$gene)

# 画热图，只显示这两组
png("Naive_Memory_CD4.png", width = 20, height = 8, units = "in", res = 300)
DoHeatmap(pbmc_cd4_sub, features = top20$gene) + NoLegend()
