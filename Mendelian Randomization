# 提取暴露数据的工具变量（SNP）
exposure_data <- extract_instruments("ukb-b-19953")

# 查看暴露数据的前 4 行
head(exposure_data)[1:4, ]

# 查看暴露数据的列名
colnames(exposure_data)

# 提取结局数据（用暴露的 SNP 去匹配结局）
outcome_data <- extract_outcome_data(
  snps = exposure_data$SNP,       # 指定要提取结局数据的 SNP 列表
  outcomes = 'ebi-a-GCST90007526', # 指定 GWAS 数据集
  proxies = FALSE,                # 不使用代理 SNP
  maf_threshold = 0.01,           # 最小等位基因频率阈值
)

# 查看结局数据
View(outcome_data)

# 协调暴露和结局数据，确保格式一致、效应方向对齐
data <- harmonise_data(
  exposure_dat = exposure_data,   # 暴露数据
  outcome_dat = outcome_data      # 结局数据
)

# 进行孟德尔随机化分析
result <- mr(data)

# 打印 MR 结果
print(result)

# 检验异质性（不同 SNP 的效应是否一致）
mr_heterogeneity(data)

# 检验多效性（SNP 是否通过其他途径影响结局）
mr_pleiotropy_test(data)

# 画散点图（暴露 vs 结局的效应）
p1 <- mr_scatter_plot(result, data)
p1

# 单 SNP 分析
result_single <- mr_singlesnp(data)

# 画森林图（每个 SNP 的效应）
p2 <- mr_forest_plot(result_single)
p2

# 留一法分析（逐个剔除 SNP，看结果是否稳健）
result_loo <- mr_leaveoneout(data)

# 画留一法图
p3 <- mr_leaveoneout_plot(result_loo)
p3

# 再次单 SNP 分析（用于漏斗图）
result_single <- mr_singlesnp(data)

# 画漏斗图（看是否存在偏倚）
p4 <- mr_funnel_plot(result_single)
p4
